<footer class="mt-auto bg-slate-900 text-slate-400 text-sm border-t border-slate-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      
      <!-- Brand column -->
      <div>
        <h3 class="text-white font-bold text-base mb-2"><%= config.appName %></h3>
        <p class="text-xs leading-relaxed text-slate-400 max-w-sm mb-4">
          Aplikasi katering nusantara terpadu berbasis Express.js MVC, PostgreSQL, dan Google Gemini Generative AI Assistant untuk praktikum PPAW.
        </p>
        <div class="flex flex-col gap-2">
          <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-800 text-slate-300 text-xs font-mono w-fit">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            Environment: <%= config.env %> (Port <%= config.port %>)
          </span>
          <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-purple-950/70 border border-purple-800 text-purple-300 text-xs font-mono w-fit">
            <span class="w-2 h-2 rounded-full bg-purple-400 animate-ping"></span>
            LLM: Google Gemini (<%= config.gemini.modelName %>)
          </span>
        </div>
      </div>

      <!-- Links Column -->
      <div>
        <h4 class="text-white font-semibold text-xs tracking-wider uppercase mb-3">Endpoint REST API Tersedia</h4>
        <ul class="space-y-2 text-xs font-mono">
          <li>
            <a href="/api/status" target="_blank" class="hover:text-amber-400 transition-colors flex items-center gap-1.5">
              <span class="text-emerald-400">GET</span> /api/status &rarr; Status Server & AI
            </a>
          </li>
          <li>
            <a href="/api/produk" target="_blank" class="hover:text-amber-400 transition-colors flex items-center gap-1.5">
              <span class="text-emerald-400">GET</span> /api/produk &rarr; Katalog PostgreSQL
            </a>
          </li>
          <li>
            <a href="/api/produk/1" target="_blank" class="hover:text-amber-400 transition-colors flex items-center gap-1.5">
              <span class="text-emerald-400">GET</span> /api/produk/:id &rarr; Detail Produk ID
            </a>
          </li>
          <li>
            <a href="#ai-assistant" class="hover:text-purple-400 transition-colors flex items-center gap-1.5">
              <span class="text-purple-400">POST</span> /api/chat &rarr; AI Assistant Endpoint
            </a>
          </li>
        </ul>
      </div>

      <!-- Group Column -->
      <div>
        <h4 class="text-white font-semibold text-xs tracking-wider uppercase mb-3"><%= config.kelompok.nama %> · <%= config.kelompok.kelas %></h4>
        <ul class="space-y-1.5 text-xs">
          <% config.kelompok.anggota.forEach(function(m) { %>
            <li class="flex items-center justify-between text-slate-400 border-b border-slate-800/60 pb-1">
              <span class="text-slate-300 font-medium"><%= m.nama %></span>
              <span class="font-mono text-slate-500"><%= m.nim %></span>
            </li>
          <% }); %>
        </ul>
      </div>

    </div>

    <div class="mt-8 pt-8 border-t border-slate-800 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-500">
      <p>&copy; 2026 <%= config.appName %> — TI-501 Pengembangan Aplikasi Web, Universitas Muhammadiyah Yogyakarta.</p>
      <p class="mt-2 sm:mt-0 font-mono">Express.js · PostgreSQL · Sequelize · Google Gemini · EJS · Tailwind CSS</p>
    </div>
  </div>
</footer>
</body>
</html>
