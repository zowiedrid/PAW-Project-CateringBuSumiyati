          Batal
        </button>
        <button type="submit" id="btn-save-edit" class="px-5 py-2.5 rounded-xl bg-amber-600 hover:bg-amber-700 text-white text-xs font-bold shadow-md shadow-amber-500/20">
          Simpan Perubahan (PUT)
        </button>
      </div>
    </form>

  </div>
</div>

<!-- ========================================== -->
<!-- MODAL 3: KONFIRMASI HAPUS (DELETE) -->
<!-- ========================================== -->
<div id="modal-delete" class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/60 backdrop-blur-sm hidden p-4">
  <div class="bg-white rounded-3xl max-w-sm w-full p-6 text-center shadow-2xl border border-slate-200">
    <div class="w-12 h-12 rounded-full bg-rose-100 text-rose-600 mx-auto flex items-center justify-center mb-4">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
    </div>
    <h3 class="text-lg font-extrabold text-slate-900 mb-2">Hapus Menu Ini?</h3>
    <p class="text-xs text-slate-500 mb-6">
      Menu <strong id="delete-item-name" class="text-slate-800"></strong> akan dihapus permanen dari database PostgreSQL.
    </p>
    <div class="flex items-center justify-center gap-3">
      <button onclick="closeDeleteModal()" class="px-4 py-2.5 rounded-xl border border-slate-200 text-xs font-bold text-slate-600 hover:bg-slate-50">
        Batal
      </button>
      <button onclick="executeDelete()" id="btn-confirm-delete" class="px-4 py-2.5 rounded-xl bg-rose-600 hover:bg-rose-700 text-white text-xs font-bold shadow-md shadow-rose-500/20">
        Ya, Hapus Permanen
      </button>
    </div>
  </div>
</div>

<!-- ========================================== -->
<!-- JAVASCRIPT FRONTEND CONTROLLER (CRUD & AJAX) -->
<!-- ========================================== -->
<script>
  // Sample payloads untuk live tester
  const samplePostPayload = {
    nama: "Paket Nasi Bogana Pesisir",
    kategori: "Nasi Box",
    harga: 32000,
    stok: 75,
    deskripsi: "Nasi kuning pulen dengan dendeng age, opor basah, telur pindang, dan serundeng gurih.",
    keunggulan: "Autentik pesisir Jawa, cocok untuk rapat eksekutif."
  };

  const samplePutPayload = {
    nama: "Paket Nasi Box Ayam Bakar Madu (Promo)",
    harga: 26000,
    stok: 180,
    keunggulan: "Spesial diskon awal bulan, bumbu rempah madu lebih pekat."
  };

  const sampleChatPayload = {
    message: "Apa saja menu nasi box yang tersedia dan berapa harganya?"
  };

  let deleteTargetId = null;

  // 1. Toast Notification
  function showToast(message, type = 'success') {
    const container = document.getElementById('toast-container');
    const toast = document.createElement('div');
    const bgClass = type === 'success' ? 'bg-emerald-600 text-white' : type === 'error' ? 'bg-rose-600 text-white' : 'bg-slate-900 text-amber-300';
    
    toast.className = `${bgClass} pointer-events-auto px-4 py-3 rounded-xl shadow-xl text-xs font-semibold flex items-center gap-2 transform transition-all duration-300 translate-y-2 opacity-0`;
    toast.innerHTML = `
      <span>${type === 'success' ? '✓' : type === 'error' ? '✕' : 'ℹ'}</span>
      <span>${message}</span>
    `;
    container.appendChild(toast);

    setTimeout(() => {
      toast.classList.remove('translate-y-2', 'opacity-0');
    }, 10);

    setTimeout(() => {
      toast.classList.add('opacity-0', 'translate-y-2');
      setTimeout(() => toast.remove(), 300);
    }, 4000);
  }

  // 2. Format Rupiah di Sisi Klien
  function formatRupiahClient(number) {
    return 'Rp ' + Number(number).toLocaleString('id-ID');
  }

  // 3. Modal Controls: CREATE
  function openCreateModal() {
    document.getElementById('form-create').reset();
    document.getElementById('modal-create').classList.remove('hidden');
  }
  function closeCreateModal() {
    document.getElementById('modal-create').classList.add('hidden');
  }

  async function handleCreateSubmit(e) {
    e.preventDefault();
    const btn = document.getElementById('btn-save-create');
    btn.disabled = true;
    btn.textContent = 'Menyimpan...';

    const payload = {
      nama: document.getElementById('create-nama').value,
      kategori: document.getElementById('create-kategori').value,
      harga: document.getElementById('create-harga').value,
      stok: document.getElementById('create-stok').value,
      rating: document.getElementById('create-rating').value,
      deskripsi: document.getElementById('create-deskripsi').value,
      keunggulan: document.getElementById('create-keunggulan').value
    };

    try {
      const res = await fetch('/api/produk', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const result = await res.json();

      if (!res.ok) throw new Error(result.pesan || 'Gagal menambahkan produk');

      showToast(result.pesan || 'Produk baru tersimpan ke database!');
      closeCreateModal();
      setTimeout(() => window.location.reload(), 800);
    } catch (err) {
      showToast(err.message, 'error');
    } finally {
      btn.disabled = false;
      btn.textContent = 'Simpan ke Database (POST)';
    }
  }

  // 4. Modal Controls: UPDATE
  function openEditModal(item) {
    document.getElementById('edit-id').value = item.id;
    document.getElementById('edit-nama').value = item.nama;
    document.getElementById('edit-kategori').value = item.kategori;
    document.getElementById('edit-harga').value = item.harga;
    document.getElementById('edit-stok').value = item.stok;
    document.getElementById('edit-terjual').value = item.terjual || 0;
    document.getElementById('edit-deskripsi').value = item.deskripsi || '';
    document.getElementById('edit-keunggulan').value = item.keunggulan || '';
    document.getElementById('modal-edit').classList.remove('hidden');
  }
  function closeEditModal() {
    document.getElementById('modal-edit').classList.add('hidden');
  }

  async function handleEditSubmit(e) {
    e.preventDefault();
    const id = document.getElementById('edit-id').value;
    const btn = document.getElementById('btn-save-edit');
    btn.disabled = true;
    btn.textContent = 'Memperbarui...';

    const payload = {
      nama: document.getElementById('edit-nama').value,
      kategori: document.getElementById('edit-kategori').value,
      harga: document.getElementById('edit-harga').value,
      stok: document.getElementById('edit-stok').value,
      terjual: document.getElementById('edit-terjual').value,
      deskripsi: document.getElementById('edit-deskripsi').value,
      keunggulan: document.getElementById('edit-keunggulan').value
    };

    try {
      const res = await fetch(`/api/produk/${id}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const result = await res.json();

      if (!res.ok) throw new Error(result.pesan || 'Gagal memperbarui produk');

      showToast(result.pesan || 'Perubahan tersimpan ke database!');
      closeEditModal();
      setTimeout(() => window.location.reload(), 800);
    } catch (err) {
      showToast(err.message, 'error');
    } finally {
      btn.disabled = false;
      btn.textContent = 'Simpan Perubahan (PUT)';
    }
  }

  // 5. Modal Controls: DELETE
  function confirmDelete(id, name) {
    deleteTargetId = id;
    document.getElementById('delete-item-name').textContent = `"${name}" (ID #${id})`;
    document.getElementById('modal-delete').classList.remove('hidden');
  }
  function closeDeleteModal() {
    deleteTargetId = null;
    document.getElementById('modal-delete').classList.add('hidden');
  }

  async function executeDelete() {
    if (!deleteTargetId) return;
    const btn = document.getElementById('btn-confirm-delete');
    btn.disabled = true;
    btn.textContent = 'Menghapus...';

    try {
      const res = await fetch(`/api/produk/${deleteTargetId}`, {
        method: 'DELETE'
      });
      const result = await res.json();

      if (!res.ok) throw new Error(result.pesan || 'Gagal menghapus produk');

      showToast(result.pesan || 'Produk terhapus dari database!');
      closeDeleteModal();
      
      const card = document.getElementById(`product-card-${deleteTargetId}`);
      if (card) {
        card.style.opacity = '0';
        card.style.transform = 'scale(0.9)';
        setTimeout(() => card.remove(), 300);
      } else {
        setTimeout(() => window.location.reload(), 800);
      }
    } catch (err) {
      showToast(err.message, 'error');
    } finally {
      btn.disabled = false;
      btn.textContent = 'Ya, Hapus Permanen';
    }
  }

  // 6. Filter & Search
  function filterByCategory(category) {
    const currentUrl = new URL(window.location.href);
    if (category === 'Semua') {
      currentUrl.searchParams.delete('kategori');
    } else {
      currentUrl.searchParams.set('kategori', category);
    }
    window.location.href = currentUrl.toString();
  }

  let searchTimeout;
  function handleSearch(val) {
    clearTimeout(searchTimeout);
    searchTimeout = setTimeout(() => {
      const currentUrl = new URL(window.location.href);
      if (val.trim() === '') {
        currentUrl.searchParams.delete('q');
      } else {
        currentUrl.searchParams.set('q', val.trim());
      }
      window.location.href = currentUrl.toString();
    }, 500);
  }

  // 7. Live REST API Tester
  async function testApiEndpoint(method, endpoint, payload = null) {
    const outputEl = document.getElementById('api-output');
    const methodEl = document.getElementById('active-method');
    const urlEl = document.getElementById('active-url');
    const statusEl = document.getElementById('response-status');
    const timeEl = document.getElementById('response-time');

    methodEl.textContent = method;
    methodEl.className = method === 'GET' ? 'text-emerald-400 font-bold' : method === 'POST' ? 'text-blue-400 font-bold' : method === 'PUT' ? 'text-yellow-400 font-bold' : 'text-red-400 font-bold';
    urlEl.textContent = endpoint;
    outputEl.textContent = `[${method}] Mengirim permintaan ke ${endpoint}...`;

    const tStart = performance.now();
    try {
      const options = {
        method: method,
        headers: { 'Content-Type': 'application/json' }
      };
      if (payload && (method === 'POST' || method === 'PUT')) {
        options.body = JSON.stringify(payload);
      }

      const res = await fetch(endpoint, options);
      const data = await res.json();
      const tEnd = performance.now();

      statusEl.textContent = `HTTP ${res.status} ${res.statusText || 'OK'}`;
      statusEl.className = res.ok ? 'text-emerald-400 font-bold' : 'text-rose-400 font-bold';
      timeEl.textContent = `Waktu: ${(tEnd - tStart).toFixed(1)} ms`;
      outputEl.textContent = JSON.stringify(data, null, 2);
    } catch (err) {
      statusEl.textContent = 'ERR_CONNECTION';
      statusEl.className = 'text-rose-400 font-bold';
      outputEl.textContent = `Gagal eksekusi: ${err.message}`;
    }
  }

  function copyOutput() {
    const text = document.getElementById('api-output').textContent;
    navigator.clipboard.writeText(text).then(() => {
      showToast('JSON respons berhasil disalin ke clipboard!');
    });
  }

  // ==========================================
  // 8. AI ASSISTANT CHATBOT (GOOGLE GEMINI & CONTEXT GROUNDING)
  // ==========================================
  const chatMessagesEl = document.getElementById('chat-messages');
  const chatInputEl = document.getElementById('chat-input');
  const typingIndicatorEl = document.getElementById('typing-indicator');
  const btnSendChatEl = document.getElementById('btn-send-chat');
  const charCounterEl = document.getElementById('char-counter');

  function handleChatInputChange(el) {
    const len = el.value.length;
    if (charCounterEl) {
      charCounterEl.textContent = `${len} / 500 karakter`;
      if (len > 450) {
        charCounterEl.className = 'text-amber-400 font-bold';
      } else {
        charCounterEl.className = 'text-slate-400';
      }
    }
  }

  function handleChatKeyDown(e) {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      document.getElementById('chat-form').requestSubmit();
    }
  }

  function fillAndSendChat(promptText) {
    if (!chatInputEl) return;
    chatInputEl.value = promptText;
    handleChatInputChange(chatInputEl);
    chatInputEl.focus();
    const chatSec = document.getElementById('ai-assistant');
    if (chatSec) {
      chatSec.scrollIntoView({ behavior: 'smooth' });
    }
    setTimeout(() => {
      document.getElementById('chat-form').requestSubmit();
    }, 200);
  }

  function formatMarkdown(text) {
    if (!text) return '';
    let escaped = text
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;');
    escaped = escaped.replace(/\*\*(.*?)\*\*/g, '<strong class="text-amber-300 font-bold">$1</strong>');
    escaped = escaped.replace(/(?:^|\n)-\s+(.*?)(?=\n|$)/g, '<br/>• $1');
    escaped = escaped.replace(/(?:^|\n)(\d+)\.\s+(.*?)(?=\n|$)/g, '<br/><strong>$1.</strong> $2');
    escaped = escaped.replace(/\n/g, '<br/>');
    return escaped;
  }

  function appendUserMessage(text) {
    const timeStr = new Date().toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' });
    const bubble = document.createElement('div');
    bubble.className = 'chat-bubble-user flex items-start justify-end gap-3';
    bubble.innerHTML = `
      <div class="flex-grow max-w-[85%] bg-gradient-to-r from-emerald-600 to-teal-600 text-white rounded-2xl rounded-tr-none p-4 shadow-md">
        <div class="flex items-center justify-between mb-1.5 gap-4">
          <span class="font-bold text-emerald-100 text-xs">Anda (Pelanggan)</span>
          <span class="text-[10px] text-emerald-200 font-mono">${timeStr}</span>
        </div>
        <p class="text-white text-xs leading-relaxed whitespace-pre-wrap">${text.replace(/</g, '&lt;').replace(/>/g, '&gt;')}</p>
      </div>
      <div class="w-8 h-8 rounded-full bg-emerald-600 text-white flex items-center justify-center shrink-0 text-xs font-bold shadow-md">
        👤
      </div>
    `;
    chatMessagesEl.appendChild(bubble);
    chatMessagesEl.scrollTop = chatMessagesEl.scrollHeight;
  }

  function appendAiMessage(replyText) {
    const timeStr = new Date().toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' });
    const formattedHtml = formatMarkdown(replyText);
    const bubble = document.createElement('div');
    bubble.className = 'chat-bubble-ai flex items-start gap-3';
    bubble.innerHTML = `
      <div class="w-8 h-8 rounded-full bg-amber-500 flex items-center justify-center text-white shrink-0 shadow-md">
        👩‍🍳
      </div>
      <div class="flex-grow max-w-[85%] bg-slate-800 border border-slate-700 text-slate-200 rounded-2xl rounded-tl-none p-4 shadow-sm">
        <div class="flex items-center justify-between mb-1.5">
          <span class="font-bold text-amber-400 text-xs">Bu Sumiyati AI</span>
          <span class="text-[10px] text-slate-400 font-mono">${timeStr}</span>
        </div>
        <div class="text-slate-200 text-xs leading-relaxed space-y-1">${formattedHtml}</div>
      </div>
    `;
    chatMessagesEl.appendChild(bubble);
    chatMessagesEl.scrollTop = chatMessagesEl.scrollHeight;
  }

  function appendErrorMessage(errorMsg, originalMessage) {
    const bubble = document.createElement('div');
    bubble.className = 'chat-bubble-error flex items-start gap-3';
    bubble.innerHTML = `
      <div class="w-8 h-8 rounded-full bg-rose-500 flex items-center justify-center text-white shrink-0 shadow-md">
        ⚠️
      </div>
      <div class="flex-grow max-w-[85%] bg-rose-950/60 border border-rose-800 text-rose-200 rounded-2xl rounded-tl-none p-4 shadow-sm">
        <div class="flex items-center justify-between mb-1.5">
          <span class="font-bold text-rose-300 text-xs">Gagal Mengirim Pertanyaan</span>
        </div>
        <p class="text-rose-200 text-xs leading-relaxed">${errorMsg}</p>
        <button onclick="fillAndSendChat('${originalMessage.replace(/'/g, "\\'")}')" class="mt-2.5 px-3 py-1 bg-rose-800 hover:bg-rose-700 text-white rounded-lg text-[11px] font-bold transition">
          ↺ Coba Kirim Ulang
        </button>
      </div>
    `;
    chatMessagesEl.appendChild(bubble);
    chatMessagesEl.scrollTop = chatMessagesEl.scrollHeight;
  }

  async function handleChatSubmit(e) {
    e.preventDefault();
    const rawMessage = chatInputEl.value.trim();
    if (!rawMessage) return;

    if (rawMessage.length > 500) {
      showToast('Pesan terlalu panjang, maksimal 500 karakter', 'error');
      return;
    }

    // 1. Tampilkan pesan pengguna di chat bubble
    appendUserMessage(rawMessage);
    chatInputEl.value = '';
    handleChatInputChange(chatInputEl);

    // 2. Aktifkan indikator loading
    typingIndicatorEl.classList.remove('hidden');
    typingIndicatorEl.classList.add('flex');
    chatMessagesEl.scrollTop = chatMessagesEl.scrollHeight;

    // 3. Matikan tombol kirim sementara
    btnSendChatEl.disabled = true;
    document.getElementById('btn-chat-text').textContent = 'Memproses...';

    try {
      const response = await fetch('/api/chat', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({ message: rawMessage })
      });

      const result = await response.json();

      if (!response.ok || !result.success) {
        throw new Error(result.message || 'Gagal menghubungi asisten AI');
      }

      const reply = result.data ? result.data.reply : result.reply;
      appendAiMessage(reply);
    } catch (err) {
      appendErrorMessage(err.message, rawMessage);
      showToast(`Error: ${err.message}`, 'error');
    } finally {
      typingIndicatorEl.classList.add('hidden');
      typingIndicatorEl.classList.remove('flex');
      btnSendChatEl.disabled = false;
      document.getElementById('btn-chat-text').textContent = 'Kirim Pesan';
      chatInputEl.focus();
    }
  }

  function resetChatMessages() {
    chatMessagesEl.innerHTML = `
      <div class="chat-bubble-ai flex items-start gap-3">
        <div class="w-8 h-8 rounded-full bg-amber-500 flex items-center justify-center text-white shrink-0 shadow-md">
          👩‍🍳
        </div>
        <div class="flex-grow max-w-[85%] bg-slate-800 border border-slate-700 text-slate-200 rounded-2xl rounded-tl-none p-4 shadow-sm">
          <div class="flex items-center justify-between mb-1.5">
            <span class="font-bold text-amber-400 text-xs">Bu Sumiyati AI</span>
            <span class="text-[10px] text-slate-400 font-mono">Sekarang</span>
          </div>
          <p class="text-slate-200 text-xs leading-relaxed">
            Riwayat chat telah dibersihkan. Halo! Saya <strong>Bu Sumiyati AI</strong>, ada yang bisa saya bantu seputar paket katering, harga, atau ketersediaan stok hari ini? 😊
          </p>
        </div>
      </div>
    `;
    showToast('Riwayat percakapan telah dibersihkan');
  }

  // Inisialisasi awal saat load
  document.addEventListener('DOMContentLoaded', () => {
    testApiEndpoint('GET', '/api/status');
    <% if (pesanSukses) { %>
      showToast("<%= pesanSukses %>", "success");
    <% } %>
    <% if (pesanError) { %>
      showToast("<%= pesanError %>", "error");
    <% } %>
  });
</script>

<%- include('partials/footer') %>
