<%- include('partials/head', { judul: judul }) %>
<%- include('partials/navbar') %>

<main class="flex-grow">
  
  <!-- NOTIFIKASI TOAST CONTAINER -->
  <div id="toast-container" class="fixed top-20 right-5 z-50 flex flex-col gap-3 pointer-events-none"></div>

  <!-- HERO SECTION DENGAN STATISTIK & TESTER LIVE REST API -->
  <section class="relative bg-gradient-to-b from-amber-50/70 via-white to-slate-50 border-b border-slate-200/80 pt-12 pb-16 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <!-- Kolom Kiri: Headline & Call to Action -->
        <div class="lg:col-span-7">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-100/80 border border-emerald-300 text-emerald-900 text-xs font-bold tracking-wide uppercase mb-6 shadow-sm">
            <span class="flex h-2 w-2 relative">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
            </span>
            PPAW Week 8 · PostgreSQL & CRUD REST API
          </div>

          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-slate-900 tracking-tight leading-[1.1] mb-6">
            Manajemen Menu Kuliner, <br class="hidden sm:inline"/>
            <span class="bg-gradient-to-r from-amber-600 via-brand-600 to-emerald-600 bg-clip-text text-transparent">
              Integrasi Penuh Database & CRUD.
            </span>
          </h1>

          <p class="text-base sm:text-lg text-slate-600 leading-relaxed mb-8 max-w-2xl">
            Solusi digital UMKM <strong><%= config.appName %></strong>. Seluruh data menu di bawah ini disimpan dan dikelola langsung pada database <strong>PostgreSQL</strong> via <strong>Sequelize ORM</strong>, lengkap dengan operasi Tambah, Tampil, Ubah, dan Hapus (CRUD).
          </p>

          <div class="flex flex-wrap items-center gap-4">
            <button onclick="openCreateModal()" class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl bg-gradient-to-r from-emerald-600 to-teal-500 hover:from-emerald-700 hover:to-teal-600 text-white font-bold text-sm shadow-lg shadow-emerald-500/25 transition-all transform hover:-translate-y-0.5">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
              Tambah Menu Baru (Create)
            </button>
            <a href="#katalog" class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl bg-white hover:bg-slate-50 text-slate-700 font-bold text-sm border border-slate-300 shadow-sm transition-all">
              <svg class="w-4 h-4 text-brand-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path></svg>
              Katalog (<span id="hero-total-count"><%= stats.totalProduk %></span> Menu)
            </a>
            <a href="#api-tester" class="inline-flex items-center gap-2 px-5 py-3.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-amber-300 font-bold text-sm shadow-sm transition-all">
              <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path></svg>
              Live API Tester
            </a>
          </div>

          <!-- Quick Stats Cards (Database Real-time Metrics) -->
          <div class="mt-10 pt-6 border-t border-slate-200/80 grid grid-cols-2 sm:grid-cols-4 gap-4 text-slate-800">
            <div class="bg-white p-3.5 rounded-xl border border-slate-200 shadow-sm">
              <span class="text-[11px] font-semibold text-slate-400 block uppercase">Total Menu</span>
              <strong class="text-xl font-extrabold text-slate-900" id="stat-total-menu"><%= stats.totalProduk %></strong>
            </div>
            <div class="bg-white p-3.5 rounded-xl border border-slate-200 shadow-sm">
              <span class="text-[11px] font-semibold text-slate-400 block uppercase">Stok Tersedia</span>
              <strong class="text-xl font-extrabold text-emerald-600" id="stat-total-stok"><%= stats.totalStok %> porsi</strong>
            </div>
            <div class="bg-white p-3.5 rounded-xl border border-slate-200 shadow-sm">
              <span class="text-[11px] font-semibold text-slate-400 block uppercase">Rata-rata Harga</span>
              <strong class="text-xl font-extrabold text-slate-900" id="stat-avg-price"><%= formatRupiah(stats.rataRataHarga) %></strong>
            </div>
            <div class="bg-white p-3.5 rounded-xl border border-slate-200 shadow-sm">
              <span class="text-[11px] font-semibold text-slate-400 block uppercase">Total Terjual</span>
              <strong class="text-xl font-extrabold text-amber-600" id="stat-total-sold"><%= stats.totalTerjual %>+</strong>
            </div>
          </div>
        </div>

        <!-- Kolom Kanan: Live Interactive REST API Tester Widget -->
        <div class="lg:col-span-5" id="api-tester">
          <div class="bg-slate-900 rounded-2xl shadow-2xl border border-slate-800 p-6 text-slate-100 font-mono text-xs">
            
            <!-- Terminal Header -->
            <div class="flex items-center justify-between pb-4 mb-4 border-b border-slate-800">
              <div class="flex items-center gap-2">
                <span class="w-3 h-3 rounded-full bg-red-500/80 inline-block"></span>
                <span class="w-3 h-3 rounded-full bg-yellow-500/80 inline-block"></span>
                <span class="w-3 h-3 rounded-full bg-emerald-500/80 inline-block"></span>
                <span class="ml-2 text-slate-400 font-semibold text-[11px]">Database Live Terminal</span>
              </div>
              <span id="live-indicator" class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded bg-emerald-950 text-emerald-400 text-[10px] border border-emerald-800">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                POSTGRESQL ONLINE
              </span>
            </div>

            <!-- Terminal Tabs for testing CRUD endpoints -->
            <div class="grid grid-cols-3 gap-1.5 mb-3">
              <button onclick="testApiEndpoint('GET', '/api/status')" class="api-btn px-2 py-1.5 rounded bg-slate-800 text-amber-300 font-semibold text-[10px] hover:bg-slate-700 transition">
                <span class="text-emerald-400 font-bold">GET</span> /status
              </button>
              <button onclick="testApiEndpoint('GET', '/api/produk')" class="api-btn px-2 py-1.5 rounded bg-slate-800 text-slate-300 font-semibold text-[10px] hover:bg-slate-700 transition">
                <span class="text-emerald-400 font-bold">GET</span> /produk
              </button>
              <button onclick="testApiEndpoint('GET', '/api/produk/1')" class="api-btn px-2 py-1.5 rounded bg-slate-800 text-slate-300 font-semibold text-[10px] hover:bg-slate-700 transition">
                <span class="text-emerald-400 font-bold">GET</span> /produk/:id
              </button>
              <button onclick="testApiEndpoint('POST', '/api/produk', samplePostPayload)" class="api-btn px-2 py-1.5 rounded bg-slate-800 text-slate-300 font-semibold text-[10px] hover:bg-slate-700 transition">
                <span class="text-blue-400 font-bold">POST</span> /produk
              </button>
              <button onclick="testApiEndpoint('PUT', '/api/produk/1', samplePutPayload)" class="api-btn px-2 py-1.5 rounded bg-slate-800 text-slate-300 font-semibold text-[10px] hover:bg-slate-700 transition">
                <span class="text-yellow-400 font-bold">PUT</span> /produk/1
              </button>
              <button onclick="testApiEndpoint('DELETE', '/api/produk/999')" class="api-btn px-2 py-1.5 rounded bg-slate-800 text-slate-300 font-semibold text-[10px] hover:bg-slate-700 transition">
                <span class="text-red-400 font-bold">DEL</span> /produk/:id
              </button>
            </div>

            <!-- Current URL requested -->
            <div class="bg-slate-950/80 rounded-lg p-2.5 mb-3 flex items-center justify-between border border-slate-800/80 text-[11px]">
              <span class="text-slate-400 truncate max-w-[200px]"><span id="active-method" class="text-emerald-400 font-bold">GET</span> <span id="active-url" class="text-amber-400 font-bold">/api/status</span></span>
              <span id="response-status" class="text-emerald-400 font-bold">HTTP 200 OK</span>
            </div>

            <!-- Output Box -->
            <div class="relative">
              <pre id="api-output" class="bg-slate-950 text-slate-200 p-4 rounded-xl overflow-x-auto max-h-60 text-[11px] leading-relaxed border border-slate-800/80 shadow-inner">Memuat respons dari backend...</pre>
              <button onclick="copyOutput()" class="absolute top-2 right-2 px-2 py-1 rounded bg-slate-800 hover:bg-slate-700 text-slate-400 text-[10px] transition-colors">
                Copy JSON
              </button>
            </div>

            <div class="mt-4 pt-3 border-t border-slate-800 text-[10px] text-slate-500 flex items-center justify-between">
              <span>*Audit request dicatat di logs/logger.md</span>
              <span id="response-time">Waktu: ~1.2 ms</span>
            </div>

          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- KATALOG MENU UTAMA & OPERASI CRUD FRONTEND -->
  <section id="katalog" class="py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Header Section Katalog -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-8 gap-4">
      <div>
        <div class="inline-flex items-center gap-2 text-xs font-bold text-brand-600 uppercase tracking-wider mb-2">
          <span>Database PostgreSQL Table: `products`</span>
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
          <span>MVC CRUD Operations</span>
        </div>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
          Katalog Menu Catering Bu Sumiyati
        </h2>
        <p class="text-slate-500 text-sm mt-1 max-w-xl">
          Setiap perubahan data (Tambah, Ubah, Hapus) pada antarmuka ini langsung tersimpan ke database PostgreSQL backend secara real-time.
        </p>
      </div>

      <!-- Action Button Tambah Menu -->
      <div class="flex items-center gap-3">
        <button onclick="openCreateModal()" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs shadow-sm transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
          Tambah Menu Baru
        </button>
      </div>
    </div>

    <!-- Filter Bar: Search Input & Category Pills -->
    <div class="bg-white p-4 rounded-2xl border border-slate-200/90 shadow-sm mb-10 flex flex-col md:flex-row items-center justify-between gap-4">
      
      <!-- Category Tabs -->
      <div class="flex flex-wrap items-center gap-2 w-full md:w-auto" id="category-pills">
        <% kategoriList.forEach(function(kat, idx) { %>
          <button 
            onclick="filterByCategory('<%= kat %>')" 
            class="filter-pill px-3.5 py-1.5 rounded-xl text-xs font-bold transition-all <%= kat === kategoriAktif ? 'bg-slate-900 text-white shadow-sm' : 'bg-slate-100 text-slate-600 hover:bg-slate-200' %>"
            data-category="<%= kat %>">
            <%= kat %>
          </button>
        <% }); %>
      </div>

      <!-- Search Input Form -->
      <div class="relative w-full md:w-72">
        <input 
          type="text" 
          id="search-input" 
          placeholder="Cari menu atau rempah..." 
          value="<%= pencarianAktif %>"
          oninput="handleSearch(this.value)"
          class="w-full pl-9 pr-4 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs font-medium focus:outline-none focus:ring-2 focus:ring-brand-500 focus:bg-white transition-all">
        <svg class="w-4 h-4 text-slate-400 absolute left-3 top-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
      </div>

    </div>

    <!-- Product Grid Container -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="product-grid">
      <% if (produk.length === 0) { %>
        <div class="col-span-full py-16 text-center bg-white rounded-2xl border border-slate-200 p-8">
          <svg class="w-16 h-16 text-slate-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"></path></svg>
          <h3 class="text-lg font-bold text-slate-800 mb-1">Belum Ada Menu</h3>
          <p class="text-sm text-slate-500 mb-4">Tidak ada data produk yang cocok dengan filter atau database kosong.</p>
          <button onclick="openCreateModal()" class="px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl text-xs font-bold transition">
            Tambah Menu Sekarang
          </button>
        </div>
      <% } else { %>
        <% produk.forEach(function(item) { %>
          <div class="product-item group bg-white rounded-2xl border border-slate-200/90 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col overflow-hidden hover:-translate-y-1" id="product-card-<%= item.id %>" data-category="<%= item.kategori %>">
            
            <!-- Card Header: ID & Category Badge -->
            <div class="p-6 pb-4 flex items-center justify-between border-b border-slate-100">
              <span class="font-mono text-xs font-bold text-slate-400">ID #0<%= item.id %></span>
              <span class="px-3 py-1 rounded-full text-[11px] font-bold uppercase tracking-wider 
                <%= item.kategori === 'Nasi Box' ? 'bg-blue-50 text-blue-700 border border-blue-200' : '' %>
                <%= item.kategori === 'Prasmanan' ? 'bg-purple-50 text-purple-700 border border-purple-200' : '' %>
                <%= item.kategori === 'Tumpeng' ? 'bg-amber-50 text-amber-700 border border-amber-200' : '' %>
                <%= item.kategori === 'Snack Box' ? 'bg-emerald-50 text-emerald-700 border border-emerald-200' : '' %>
                <%= !['Nasi Box','Prasmanan','Tumpeng','Snack Box'].includes(item.kategori) ? 'bg-slate-100 text-slate-700 border border-slate-200' : '' %>
              ">
                <%= item.kategori %>
              </span>
            </div>

            <!-- Card Body: Name, Rating, Description -->
            <div class="p-6 flex-grow flex flex-col justify-between">
              <div>
                <div class="flex items-center gap-1.5 text-xs text-amber-500 mb-2">
                  <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg>
                  <span class="font-bold text-slate-800"><%= item.rating %></span>
                  <span class="text-slate-400">· Terjual <%= item.terjual %>+</span>
                </div>

                <h3 class="text-lg font-bold text-slate-900 group-hover:text-brand-600 transition-colors leading-snug mb-2 item-name">
                  <%= item.nama %>
                </h3>

                <p class="text-xs text-slate-500 leading-relaxed mb-4 item-desc">
                  <%= item.deskripsi || 'Menu higienis khas Catering Bu Sumiyati.' %>
                </p>
              </div>

              <!-- Card Highlights -->
              <div class="pt-4 border-t border-dashed border-slate-200">
                <div class="flex items-start gap-2 text-xs text-slate-600 mb-4 bg-slate-50 p-2.5 rounded-lg border border-slate-100">
                  <svg class="w-4 h-4 text-emerald-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                  <span class="text-[11px] leading-tight item-usp"><%= item.keunggulan %></span>
                </div>

                <div class="flex items-baseline justify-between">
                  <div>
                    <span class="text-[11px] font-semibold text-slate-400 block leading-none">Harga Paket</span>
                    <span class="text-xl font-extrabold text-slate-900 tracking-tight item-price"><%= formatRupiah(item.harga) %></span>
                  </div>
                  <span class="text-xs font-semibold text-slate-500 bg-slate-100 px-2.5 py-1 rounded-md item-stock">
                    Stok: <%= item.stok %> porsi
                  </span>
                </div>
              </div>

            </div>

            <!-- Card Bottom Action Bar (CRUD Actions) -->
            <div class="px-6 py-3.5 bg-slate-50/80 border-t border-slate-100 flex items-center justify-between text-xs font-semibold">
              <a href="/api/produk/<%= item.id %>" target="_blank" class="text-slate-500 hover:text-brand-600 font-mono text-[11px] inline-flex items-center gap-1">
                JSON &rarr;
              </a>
              
              <div class="flex items-center gap-2">
                <!-- Tombol Edit (Ubah) -->
                <button 
                  onclick='openEditModal(<%= JSON.stringify(item) %>)' 
                  class="px-3 py-1.5 rounded-lg bg-amber-50 hover:bg-amber-100 text-amber-700 border border-amber-200 font-medium text-xs transition-colors flex items-center gap-1">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                  Edit
                </button>

                <!-- Tombol Hapus (Delete) -->
                <button 
                  onclick="confirmDelete(<%= item.id %>, '<%= item.nama %>')" 
                  class="px-3 py-1.5 rounded-lg bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200 font-medium text-xs transition-colors flex items-center gap-1">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                  Hapus
                </button>
              </div>

            </div>

          </div>
        <% }); %>
      <% } %>
    </div>

  </section>

  <!-- KELOMPOK SECTION -->
  <section id="kelompok" class="py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 border-t border-slate-200/80">
    <div class="bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 rounded-3xl p-8 sm:p-12 text-white shadow-xl relative overflow-hidden">
      
      <div class="relative z-10 max-w-3xl">
        <span class="text-xs font-bold text-amber-400 tracking-wider uppercase mb-2 block">PPAW Week 8 · Project Berkelanjutan</span>
        <h2 class="text-3xl font-extrabold tracking-tight mb-4">Tim Pengembang <%= config.kelompok.nama %> (<%= config.kelompok.kelas %>)</h2>
        <p class="text-sm text-slate-300 leading-relaxed mb-8">
          Repository ini dikembangkan secara berkelanjutan untuk mata kuliah <strong>TI-501 Pengembangan Aplikasi Web</strong>. Implementasi Week 8 berhasil mengintegrasikan database PostgreSQL dan seluruh operasi CRUD dari frontend ke backend.
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <% anggotaKelompok.forEach(function(member, idx) { %>
            <div class="flex items-center gap-3.5 bg-slate-800/80 p-3.5 rounded-xl border border-slate-700/80">
              <div class="w-10 h-10 rounded-lg bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 flex items-center justify-center font-bold text-sm">
                0<%= idx + 1 %>
              </div>
              <div>
                <strong class="text-sm text-white block leading-snug"><%= member.nama %></strong>
                <span class="text-xs font-mono text-amber-300"><%= member.nim %></span>
                <span class="text-[11px] text-slate-400 block leading-tight"><%= member.peran %></span>
              </div>
            </div>
          <% }); %>
        </div>
      </div>

    </div>
  </section>

</main>

<!-- ========================================== -->
<!-- MODAL 1: TAMBAH MENU BARU (CREATE) -->
<!-- ========================================== -->
<div id="modal-create" class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/60 backdrop-blur-sm hidden p-4">
  <div class="bg-white rounded-3xl max-w-lg w-full p-6 sm:p-8 shadow-2xl border border-slate-200 transform transition-all">
    
    <div class="flex items-center justify-between pb-4 mb-5 border-b border-slate-100">
      <div>
        <h3 class="text-xl font-extrabold text-slate-900">Tambah Menu Baru</h3>
        <p class="text-xs text-slate-500">Data akan langsung disimpan ke database PostgreSQL</p>
      </div>
      <button onclick="closeCreateModal()" class="w-8 h-8 rounded-full bg-slate-100 hover:bg-slate-200 flex items-center justify-center text-slate-500">
        ✕
      </button>
    </div>

    <form id="form-create" onsubmit="handleCreateSubmit(event)" class="space-y-4">
      <div>
        <label class="block text-xs font-bold text-slate-700 uppercase mb-1">Nama Menu *</label>
        <input type="text" name="nama" id="create-nama" required placeholder="Contoh: Paket Nasi Kuning Cakalang" class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs font-medium focus:ring-2 focus:ring-emerald-500 focus:bg-white focus:outline-none">
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-bold text-slate-700 uppercase mb-1">Kategori *</label>
          <select name="kategori" id="create-kategori" required class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs font-medium focus:ring-2 focus:ring-emerald-500 focus:bg-white focus:outline-none">
            <option value="Nasi Box">Nasi Box</option>
            <option value="Prasmanan">Prasmanan</option>
            <option value="Tumpeng">Tumpeng</option>
