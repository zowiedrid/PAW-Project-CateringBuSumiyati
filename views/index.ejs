      <div>
        <label class="block text-xs font-bold text-slate-700 uppercase mb-1">Keunggulan / Catatan Khusus</label>
        <input type="text" name="keunggulan" id="create-keunggulan" placeholder="Contoh: Kemasan ramah lingkungan, halal MUI." class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs font-medium focus:ring-2 focus:ring-emerald-500 focus:bg-white focus:outline-none">
      </div>

      <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-100">
        <button type="button" onclick="closeCreateModal()" class="px-5 py-2.5 rounded-xl border border-slate-200 text-xs font-bold text-slate-600 hover:bg-slate-50">
          Batal
        </button>
        <button type="submit" id="btn-save-create" class="px-5 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold shadow-md shadow-emerald-500/20">
          Simpan ke Database (POST)
        </button>
      </div>
    </form>

  </div>
</div>

